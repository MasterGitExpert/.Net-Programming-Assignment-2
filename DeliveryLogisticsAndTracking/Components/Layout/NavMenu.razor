@if (user is null)
{
        <p><em>Loading...</em></p>
}else
{
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="">Net Logistics</a>
        </div>
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />



    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <nav class="nav flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"home?userid={user.UserId}")">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </NavLink>
            </div>
            @if ( user.RoleId == 1)
            {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"roles?userid={user.UserId}")">
                    <span class="bi bi-person-vcard-fill fs-5 pb-5" aria-hidden="true"></span> Manage Roles
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"users?userid={user.UserId}")">
                    <span class="bi bi-person-fill-gear fs-5 pb-5" aria-hidden="true"></span> Manage Users
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"vehicletypes?userid={user.UserId}")">
                    <span class="bi bi-fuel-pump-fill fs-5 pb-5" aria-hidden="true"></span> Manage Vehicle Types
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"vehicles?userid={user.UserId}")">
                    <span class="bi bi-car-front-fill fs-5 pb-5" aria-hidden="true"></span> Manage Vehicles
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"vendors?userid={user.UserId}")">
                    <span class="bi bi-building-gear fs-5 pb-5" aria-hidden="true"></span> Manage Vendors
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"shipments?userid={user.UserId}")">
                    <span class="bi bi-box-fill fs-5 pb-5" aria-hidden="true"></span> Manage Shipments
                </NavLink>
            </div>
            }

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"schedule?userid={user.UserId}")">
                    <span class="bi bi-calendar-date-fill fs-5 pb-5" aria-hidden="true"></span> Schedule
                </NavLink>
            </div>

            <div class="nav-item px-3 position-absolute bottom-0">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-box-arrow-left fs-5 pb-5" aria-hidden="true"></span> Logout
                </NavLink>
            </div>

        </nav>
    </div>
}


@code {
    private UserTwo? user = new UserTwo();

    private class UserTwo
    {
        public int UserId = 2;
        public int RoleId = 1;
    }
}