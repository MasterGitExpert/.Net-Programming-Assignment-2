@page "/deliveries/details"
@using Microsoft.EntityFrameworkCore
@using DeliveryLogisticsAndTracking
@inject IDbContextFactory<DeliveryLogisticsAndTracking.Data.DeliveryLogisticsAndTrackingContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Delivery</h2>
    <hr />
    @if (delivery is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">DeliveryDateTime</dt>
            <dd class="col-sm-10">@delivery.DeliveryDateTime</dd>
            <dt class="col-sm-2">Source</dt>
            <dd class="col-sm-10">@delivery.Source</dd>
            <dt class="col-sm-2">Destination</dt>
            <dd class="col-sm-10">@delivery.Destination</dd>
            <dt class="col-sm-2">DeliveryCharge</dt>
            <dd class="col-sm-10">@delivery.DeliveryCharge</dd>
            <dt class="col-sm-2">DriverId</dt>
            <dd class="col-sm-10">@delivery.DriverId</dd>
            <dt class="col-sm-2">DeliveryVehicleId</dt>
            <dd class="col-sm-10">@delivery.DeliveryVehicleId</dd>
            <dt class="col-sm-2">GoodsShipmentId</dt>
            <dd class="col-sm-10">@delivery.GoodsShipmentId</dd>
        </dl>
        <div>
            <a href="@($"/deliveries/edit?deliveryid={delivery.DeliveryId}")">Edit</a> |
            <a href="@($"/deliveries")">Back to List</a>
        </div>
    }
</div>

@code {
    private Delivery? delivery;

    [SupplyParameterFromQuery]
    private int DeliveryId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        delivery = await context.Delivery.FirstOrDefaultAsync(m => m.DeliveryId == DeliveryId);

        if (delivery is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
