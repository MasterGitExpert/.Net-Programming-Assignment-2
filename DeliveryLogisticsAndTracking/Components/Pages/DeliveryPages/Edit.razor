@page "/deliveries/edit"
@using Microsoft.EntityFrameworkCore
@using DeliveryLogisticsAndTracking
@inject IDbContextFactory<DeliveryLogisticsAndTracking.Data.DeliveryLogisticsAndTrackingContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Delivery</h2>
<hr />
@if (Delivery is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Delivery" OnValidSubmit="UpdateDelivery" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Delivery.DeliveryId" value="@Delivery.DeliveryId" />
                <div class="mb-3">
                    <label for="deliverydatetime" class="form-label">DeliveryDateTime:</label>
                    <InputDate id="deliverydatetime" @bind-Value="Delivery.DeliveryDateTime" class="form-control" />
                    <ValidationMessage For="() => Delivery.DeliveryDateTime" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="source" class="form-label">Source:</label>
                    <InputText id="source" @bind-Value="Delivery.Source" class="form-control" />
                    <ValidationMessage For="() => Delivery.Source" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="destination" class="form-label">Destination:</label>
                    <InputText id="destination" @bind-Value="Delivery.Destination" class="form-control" />
                    <ValidationMessage For="() => Delivery.Destination" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="deliverycharge" class="form-label">DeliveryCharge:</label>
                    <InputNumber id="deliverycharge" @bind-Value="Delivery.DeliveryCharge" class="form-control" />
                    <ValidationMessage For="() => Delivery.DeliveryCharge" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="driverid" class="form-label">DriverId:</label>
                    <InputNumber id="driverid" @bind-Value="Delivery.DriverId" class="form-control" />
                    <ValidationMessage For="() => Delivery.DriverId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="deliveryvehicleid" class="form-label">DeliveryVehicleId:</label>
                    <InputNumber id="deliveryvehicleid" @bind-Value="Delivery.DeliveryVehicleId" class="form-control" />
                    <ValidationMessage For="() => Delivery.DeliveryVehicleId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="goodsshipmentid" class="form-label">GoodsShipmentId:</label>
                    <InputNumber id="goodsshipmentid" @bind-Value="Delivery.GoodsShipmentId" class="form-control" />
                    <ValidationMessage For="() => Delivery.GoodsShipmentId" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/deliveries">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int DeliveryId { get; set; }

    [SupplyParameterFromForm]
    private Delivery? Delivery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Delivery ??= await context.Delivery.FirstOrDefaultAsync(m => m.DeliveryId == DeliveryId);

        if (Delivery is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateDelivery()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Delivery!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!DeliveryExists(Delivery!.DeliveryId))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/deliveries");
    }

    private bool DeliveryExists(int deliveryid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Delivery.Any(e => e.DeliveryId == deliveryid);
    }
}
