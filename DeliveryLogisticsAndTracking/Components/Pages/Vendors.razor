@page "/vendors"
@using Microsoft.EntityFrameworkCore
@using DeliveryLogisticsAndTracking.Data
@using DeliveryLogisticsAndTracking.Models
@inject AppDbContext DbContext
@inject SessionStateService SessionStateService
@inject NavigationManager Navigation

<h3>Vendor Management</h3>

@if (SessionStateService.UserType != "Admin")
{
    <p class="text-danger">Access denied. Admins only.</p>
}
else
{
    <button class="btn btn-primary mb-3" @onclick="ShowAddVendorModal">Add New Vendor</button>

    @if (showAddVendorModal)
    {
        <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content p-3">
                    <div class="modal-header">
                        <h5 class="modal-title">Add New Vendor</h5>
                        <button type="button" class="btn-close" @onclick="HideAddVendorModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(formError))
                        {
                            <div class="alert alert-danger">@formError</div>
                        }

                        <EditForm Model="newVendor" OnValidSubmit="HandleValidSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label>Vendor Name</label>
                                <InputText class="form-control" @bind-Value="newVendor.VendorName" />
                            </div>

                            <button type="submit" class="btn btn-primary">Add Vendor</button>
                            <button type="button" class="btn btn-secondary ms-2" @onclick="HideAddVendorModal">Cancel</button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }

    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Vendor Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var vendor in vendors)
            {
                <tr>
                    <td>@vendor.VendorId</td>
                    <td>@vendor.VendorName</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteVendor(vendor.VendorId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Vendor> vendors = new();
    private Vendor newVendor = new();
    private string formError = string.Empty;
    private bool showAddVendorModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadVendors();
    }

    private async Task LoadVendors()
    {
        vendors = await DbContext.Vendors.ToListAsync();
    }

    private void ShowAddVendorModal()
    {
        newVendor = new Vendor();
        formError = string.Empty;
        showAddVendorModal = true;
    }

    private void HideAddVendorModal() => showAddVendorModal = false;

    private async Task HandleValidSubmit()
    {
        if (string.IsNullOrWhiteSpace(newVendor.VendorName))
        {
            formError = "Vendor Name is required.";
            return;
        }

        try
        {
            DbContext.Vendors.Add(newVendor);
            await DbContext.SaveChangesAsync();
            showAddVendorModal = false;
            await LoadVendors();
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
    }

    private void EditVendor(int id) => Navigation.NavigateTo($"/edit/vendor/{id}");

    private async Task DeleteVendor(int id)
    {
        var vendor = await DbContext.Vendors.FindAsync(id);
        if (vendor != null)
        {
            DbContext.Vendors.Remove(vendor);
            await DbContext.SaveChangesAsync();
            vendors.Remove(vendor);
        }
    }
}
