@page "/maps"

@rendermode InteractiveServer
@using Radzen
@using Radzen.Blazor
@using System.Linq.Dynamic.Core;
@using System.Linq;
@inject IJSRuntime JS
@using Microsoft.JSInterop
@inject IGeolocationService Geolocation
@using DeliveryLogisticsAndTracking.Components.Models
@using DotNetEnv;

<PageTitle>Delivery Map</PageTitle>
<div style="margin-bottom: 1rem">
    <RadzenText TextStyle="TextStyle.H3">Delivery Map</RadzenText>
</div>

<div class="row">
    <!-- Packages to be delivered list -->
    <div style="flex: 1; max-height: 800px; overflow-y: auto; ">
        <RadzenText TextStyle="TextStyle.H6">Packages to Deliver</RadzenText>

        @foreach (var pkg in packages)
        {
            <div class="package-card" @onclick="() => OnPackageSelect(pkg)">
                <RadzenCard Variant="Variant.Outlined" class="rz-my-8 rz-mx-auto rz-shadow-2 rz-border-radius-4" Style="max-width: 420px">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="10px" class="rz-p-4">
                        <RadzenIcon Icon="package_2" />
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Overline" class="rz-display-flex rz-mt-4 rz-mb-0">Location</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1"><b>@pkg.Name</b></RadzenText>
                            <RadzenText TextStyle="TextStyle.Overline" class="rz-display-flex rz-mt-4 rz-mb-0">Status</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body1"><b>@(pkg.Status ?? "N/A")</b></RadzenText>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </div>
        }
    </div>

    <!-- Delivery Map -->
    <div class="col-9">
        <RadzenGoogleMap style="height: 800px" MapId="2cc58eba15772a5e95a654c8" ApiKey=@apiKey MapClick=@OnMapClick Center=@driverLocation
                         Data=@markers Zoom=@zoom Options=@(new Dictionary<string, object> { { "disableDoubleClickZoom", true } })>
        </RadzenGoogleMap>
    </div>
</div>


@code {
    IList<RadzenGoogleMapMarker> markers = new List<RadzenGoogleMapMarker>();
    GoogleMapPosition driverLocation = new GoogleMapPosition() { Lat = -33.86, Lng = 151.21 }; // Sydney default
    GoogleMapPosition packageDestination = new GoogleMapPosition() { Lat = -33.88386333154902, Lng = 151.19925758418867 }; // UTS Engineering Building default
    GeolocationPosition? _position;
    GeolocationPositionError? _positionError;
    List<Package> packages = new();

    int zoom = 10;
    bool _isLoading = true;
    private string? apiKey;

    readonly PositionOptions _options = new()
    {
        EnableHighAccuracy = true,
        MaximumAge = null,
        Timeout = 15_000
    };

    protected override void OnInitialized()
    {
        markers.Add(new RadzenGoogleMapMarker { Position = packageDestination, Title = "Package Destination", Label = $"{destination}" });
        apiKey = Environment.GetEnvironmentVariable("GOOGLE_MAPS_API_KEY");

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        // sample data
        packages = new()
        {
            new Package { Name = "Bondi Beach", Destination = new GoogleMapPosition { Lat = -33.8915, Lng = 151.2767 }, Status = "In Transit" },
            new Package { Name = "Parramatta", Destination = new GoogleMapPosition { Lat = -33.8150, Lng = 151.0030 }, Status = "In Transit" },
            new Package { Name = "Manly", Destination = new GoogleMapPosition { Lat = -33.7958, Lng = 151.2890 }, Status = "In Transit" },
            new Package { Name = "Penrith", Destination = new GoogleMapPosition { Lat = -33.7490, Lng = 150.6960 }, Status = "In Transit" },
            new Package { Name = "Liverpool", Destination = new GoogleMapPosition { Lat = -33.9173, Lng = 150.9171 }, Status = "In Transit" },
            new Package { Name = "Cronulla", Destination = new GoogleMapPosition { Lat = -34.0411, Lng = 151.1575 }, Status = "In Transit" },
            new Package { Name = "Northern Beaches", Destination = new GoogleMapPosition { Lat = -33.7400, Lng = 151.3000 }, Status = "In Transit" },
            new Package { Name = "Sutherland", Destination = new GoogleMapPosition { Lat = -34.0284, Lng = 151.0310 }, Status = "In Transit" },
            new Package { Name = "Ryde", Destination = new GoogleMapPosition { Lat = -33.8110, Lng = 151.0940 }, Status = "In Transit" },
            new Package { Name = "Campbelltown", Destination = new GoogleMapPosition { Lat = -34.0736, Lng = 150.8142 }, Status = "In Transit" },
        };

        markers.Add(new RadzenGoogleMapMarker
        {
            Position = packageDestination,
            Title = "Package Destination",
            Label = $"{destination}"
        });

        await GetDriverLocationAsync();
    }

    private async Task OnPackageSelect(Package selected)
    {
        packageDestination = selected.Destination;

        // clear old destination markers (keep driver)
        markers = markers.Where(m => m.Title != "Package Destination").ToList();

        markers.Add(new RadzenGoogleMapMarker
        {
            Position = packageDestination,
            Title = "Package Destination",
            Label = $"{destination}"
        });

        driverLocation = packageDestination; // recenter map on destination
        await JS.InvokeVoidAsync("console.log", $"Package '{selected.Name}' selected: {packageDestination.Lat}, {packageDestination.Lng}");

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender is false)
        {
            return;
        }

        // get current position
        await Geolocation.GetCurrentPositionAsync(
            component: this,
            onSuccessCallbackMethodName: nameof(OnPositionReceived),
            onErrorCallbackMethodName: nameof(OnPositionError),
            options: _options);
    }

    [JSInvokable]
    public void OnPositionReceived(GeolocationPosition position)
    {
        _isLoading = false;
        _position = position;
        JS.InvokeVoidAsync("console.log", $"Current Location here Lat: {position.Coords.Latitude}, Lng: {position.Coords.Longitude}");

        driverLocation = new GoogleMapPosition() { Lat = position.Coords.Latitude, Lng = position.Coords.Longitude };
        markers.Add(new RadzenGoogleMapMarker { Position = driverLocation, Title = "Current Location", Label = $"{driver}" });

        StateHasChanged();
    }

    [JSInvokable]
    public void OnPositionError(GeolocationPositionError positionError)
    {
        _isLoading = false;
        _positionError = positionError;
        StateHasChanged();
    }

    private async Task OnMapClick(GoogleMapClickEventArgs args)
    {
        await JS.InvokeVoidAsync("console.log", $"Map clicked at Lat: {args.Position.Lat}, Lng: {args.Position.Lng}");
    }

    private async Task GetDriverLocationAsync()
    {
        try
        {
            var position = await JS.InvokeAsync<GeolocationResult>("getCurrentPosition");
            try
            {
                GeolocationCoordinates coordinates = _position.Coords;
                await JS.InvokeVoidAsync("console.log", $"Current Location at Lat: {coordinates.Latitude}, Lng: {coordinates.Longitude}");

            }
            catch
            {
                await JS.InvokeVoidAsync("console.log", "Error getting location");
            }

            driverLocation = new GoogleMapPosition() { Lat = position.Latitude, Lng = position.Longitude };
        }
        catch
        {
            // fallback if geolocation fails
            driverLocation = new GoogleMapPosition() { Lat = -27.39, Lng = 153.13 };
        }
    }

    public class GeolocationResult
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
    }

