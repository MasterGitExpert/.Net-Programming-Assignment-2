@page "/roles"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using DeliveryLogisticsAndTracking
@using DeliveryLogisticsAndTracking.Data
@implements IAsyncDisposable
@inject IDbContextFactory<DeliveryLogisticsAndTracking.Data.DeliveryLogisticsAndTrackingContext> DbFactory
@rendermode InteractiveServer

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="roles/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Role">
    <PropertyColumn Property="role => role.RoleName" Title="Role Name" Sortable="true"/>

    <TemplateColumn Context="role">
        <a href="@($"roles/edit?roleid={role.RoleId}")">Edit</a> |
        <a href="@($"roles/details?roleid={role.RoleId}")">Details</a> |
        <a href="@($"roles/delete?roleid={role.RoleId}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private DeliveryLogisticsAndTrackingContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
