@code {
    private LoginModel loginModel = new();
    private string loginError = string.Empty;

    private async Task HandleLogin()
    {
        var user = await UserService.GetUserByEmailAsync(loginModel.Email?.Trim() ?? "");
        if (user == null)
        {
            loginError = "User not found.";
            return;
        }

        var valid = await UserService.ValidateLoginAsync(user.UserId, loginModel.Password?.Trim() ?? "");
        if (!valid)
        {
            loginError = "Invalid password.";
            return;
        }

        await SessionStateService.SetUserAsync(user.UserId, user.UserType);
        Navigation.NavigateTo("/home");
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
} *@