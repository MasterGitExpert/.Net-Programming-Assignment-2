@page "/vendors/delete"
@using Microsoft.EntityFrameworkCore
@using DeliveryLogisticsAndTracking
@inject IDbContextFactory<DeliveryLogisticsAndTracking.Data.DeliveryLogisticsAndTrackingContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Vendor</h2>
    <hr />
    @if (vendor is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">VendorName</dt>
            <dd class="col-sm-10">@vendor.VendorName</dd>
        </dl>
        <EditForm method="post" Model="vendor" OnValidSubmit="DeleteVendor" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(vendor is null)">Delete</button> |
            <a href="/vendors">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Vendor? vendor;

    [SupplyParameterFromQuery]
    private int VendorId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        vendor = await context.Vendor.FirstOrDefaultAsync(m => m.VendorId == VendorId);

        if (vendor is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteVendor()
    {
        using var context = DbFactory.CreateDbContext();
        context.Vendor.Remove(vendor!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/vendors");
    }
}
