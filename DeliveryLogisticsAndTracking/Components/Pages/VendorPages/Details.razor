@page "/vendors/details"
@using Microsoft.EntityFrameworkCore
@using DeliveryLogisticsAndTracking
@inject IDbContextFactory<DeliveryLogisticsAndTracking.Data.DeliveryLogisticsAndTrackingContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Vendor</h2>
    <hr />
    @if (vendor is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">VendorName</dt>
            <dd class="col-sm-10">@vendor.VendorName</dd>
        </dl>
        <div>
            <a href="@($"/vendors/edit?vendorid={vendor.VendorId}")">Edit</a> |
            <a href="@($"/vendors")">Back to List</a>
        </div>
    }
</div>

@code {
    private Vendor? vendor;

    [SupplyParameterFromQuery]
    private int VendorId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        vendor = await context.Vendor.FirstOrDefaultAsync(m => m.VendorId == VendorId);

        if (vendor is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
