@page "/vendors/edit"
@using Microsoft.EntityFrameworkCore
@using DeliveryLogisticsAndTracking
@inject IDbContextFactory<DeliveryLogisticsAndTracking.Data.DeliveryLogisticsAndTrackingContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Vendor</h2>
<hr />
@if (Vendor is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Vendor" OnValidSubmit="UpdateVendor" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Vendor.VendorId" value="@Vendor.VendorId" />
                <div class="mb-3">
                    <label for="vendorname" class="form-label">VendorName:</label>
                    <InputText id="vendorname" @bind-Value="Vendor.VendorName" class="form-control" />
                    <ValidationMessage For="() => Vendor.VendorName" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/vendors">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int VendorId { get; set; }

    [SupplyParameterFromForm]
    private Vendor? Vendor { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Vendor ??= await context.Vendor.FirstOrDefaultAsync(m => m.VendorId == VendorId);

        if (Vendor is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateVendor()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Vendor!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!VendorExists(Vendor!.VendorId))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/vendors");
    }

    private bool VendorExists(int vendorid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Vendor.Any(e => e.VendorId == vendorid);
    }
}
