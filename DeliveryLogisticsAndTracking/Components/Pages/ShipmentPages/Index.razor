@page "/shipments"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using DeliveryLogisticsAndTracking
@using DeliveryLogisticsAndTracking.Data
@implements IAsyncDisposable
@inject IDbContextFactory<DeliveryLogisticsAndTracking.Data.DeliveryLogisticsAndTrackingContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="shipments/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Shipment">
    <PropertyColumn Property="shipment => shipment.ShipmentName" />
    <PropertyColumn Property="shipment => shipment.Weight" />
    <PropertyColumn Property="shipment => shipment.Priority" />
    <PropertyColumn Property="shipment => shipment.VendorId" />

    <TemplateColumn Context="shipment">
        <a href="@($"shipments/edit?shipmentid={shipment.ShipmentId}")">Edit</a> |
        <a href="@($"shipments/details?shipmentid={shipment.ShipmentId}")">Details</a> |
        <a href="@($"shipments/delete?shipmentid={shipment.ShipmentId}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private DeliveryLogisticsAndTrackingContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
