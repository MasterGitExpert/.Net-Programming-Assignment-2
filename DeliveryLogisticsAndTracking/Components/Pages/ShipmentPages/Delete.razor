@page "/shipments/delete"
@using Microsoft.EntityFrameworkCore
@using DeliveryLogisticsAndTracking
@inject IDbContextFactory<DeliveryLogisticsAndTracking.Data.DeliveryLogisticsAndTrackingContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Shipment</h2>
    <hr />
    @if (shipment is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">ShipmentName</dt>
            <dd class="col-sm-10">@shipment.ShipmentName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Weight</dt>
            <dd class="col-sm-10">@shipment.Weight</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Priority</dt>
            <dd class="col-sm-10">@shipment.Priority</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Fragile</dt>
            <dd class="col-sm-10">@shipment.Fragile</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">VendorId</dt>
            <dd class="col-sm-10">@shipment.VendorId</dd>
        </dl>
        <EditForm method="post" Model="shipment" OnValidSubmit="DeleteShipment" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(shipment is null)">Delete</button> |
            <a href="/shipments">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Shipment? shipment;

    [SupplyParameterFromQuery]
    private int ShipmentId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        shipment = await context.Shipment.FirstOrDefaultAsync(m => m.ShipmentId == ShipmentId);

        if (shipment is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteShipment()
    {
        using var context = DbFactory.CreateDbContext();
        context.Shipment.Remove(shipment!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/shipments");
    }
}
