@page "/shipments/create"
@using Microsoft.EntityFrameworkCore
@using DeliveryLogisticsAndTracking
@inject IDbContextFactory<DeliveryLogisticsAndTracking.Data.DeliveryLogisticsAndTrackingContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Shipment</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Shipment" OnValidSubmit="AddShipment" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="shipmentname" class="form-label">ShipmentName:</label> 
                <InputText id="shipmentname" @bind-Value="Shipment.ShipmentName" class="form-control" /> 
                <ValidationMessage For="() => Shipment.ShipmentName" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="weight" class="form-label">Weight:</label> 
                <InputNumber id="weight" @bind-Value="Shipment.Weight" class="form-control" /> 
                <ValidationMessage For="() => Shipment.Weight" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="priority" class="form-label">Priority:</label> 
                <InputNumber id="priority" @bind-Value="Shipment.Priority" class="form-control" /> 
                <ValidationMessage For="() => Shipment.Priority" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="fragile" class="form-label">Fragile:</label> 
                <InputCheckbox id="fragile" @bind-Value="Shipment.Fragile" class="form-check-input" /> 
                <ValidationMessage For="() => Shipment.Fragile" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="vendorid" class="form-label">VendorId:</label> 
                <InputNumber id="vendorid" @bind-Value="Shipment.VendorId" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Shipment.VendorId" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/shipments">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Shipment Shipment { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddShipment()
    {
        using var context = DbFactory.CreateDbContext();
        context.Shipment.Add(Shipment);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/shipments");
    }
}
