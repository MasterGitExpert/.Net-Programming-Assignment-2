@page "/vehicles"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using DeliveryLogisticsAndTracking
@using DeliveryLogisticsAndTracking.Data
@implements IAsyncDisposable
@inject IDbContextFactory<DeliveryLogisticsAndTracking.Data.DeliveryLogisticsAndTrackingContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="vehicles/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Vehicle">
    <PropertyColumn Property="vehicle => vehicle.RegistrationNumber" />
    <PropertyColumn Property="vehicle => vehicle.PayloadCapacity" />
    <PropertyColumn Property="vehicle => vehicle.VehicleCost" />
    <PropertyColumn Property="vehicle => vehicle.VehicleTypeId" />

    <TemplateColumn Context="vehicle">
        <a href="@($"vehicles/edit?vehicleid={vehicle.VehicleId}")">Edit</a> |
        <a href="@($"vehicles/details?vehicleid={vehicle.VehicleId}")">Details</a> |
        <a href="@($"vehicles/delete?vehicleid={vehicle.VehicleId}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private DeliveryLogisticsAndTrackingContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
