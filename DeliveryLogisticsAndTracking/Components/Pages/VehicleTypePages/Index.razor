@page "/vehicletypes"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using DeliveryLogisticsAndTracking
@using DeliveryLogisticsAndTracking.Data
@implements IAsyncDisposable
@inject IDbContextFactory<DeliveryLogisticsAndTracking.Data.DeliveryLogisticsAndTrackingContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="vehicletypes/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.VehicleType">
    <PropertyColumn Property="vehicletype => vehicletype.VehicleTypeName" />

    <TemplateColumn Context="vehicletype">
        <a href="@($"vehicletypes/edit?vehicletypeid={vehicletype.VehicleTypeId}")">Edit</a> |
        <a href="@($"vehicletypes/details?vehicletypeid={vehicletype.VehicleTypeId}")">Details</a> |
        <a href="@($"vehicletypes/delete?vehicletypeid={vehicletype.VehicleTypeId}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private DeliveryLogisticsAndTrackingContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
