@page "/vehicletypes/details"
@using Microsoft.EntityFrameworkCore
@using DeliveryLogisticsAndTracking
@inject IDbContextFactory<DeliveryLogisticsAndTracking.Data.DeliveryLogisticsAndTrackingContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>VehicleType</h2>
    <hr />
    @if (vehicletype is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">VehicleTypeName</dt>
            <dd class="col-sm-10">@vehicletype.VehicleTypeName</dd>
        </dl>
        <div>
            <a href="@($"/vehicletypes/edit?vehicletypeid={vehicletype.VehicleTypeId}")">Edit</a> |
            <a href="@($"/vehicletypes")">Back to List</a>
        </div>
    }
</div>

@code {
    private VehicleType? vehicletype;

    [SupplyParameterFromQuery]
    private int VehicleTypeId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        vehicletype = await context.VehicleType.FirstOrDefaultAsync(m => m.VehicleTypeId == VehicleTypeId);

        if (vehicletype is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
