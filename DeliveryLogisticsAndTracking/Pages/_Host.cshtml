@page "/"
@namespace DeliveryLogisticsAndTracking.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Delivery Logistics and Tracking</title>
    <base href="~/" />

    <!-- Bootstrap CSS (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" crossorigin="anonymous">

    <!-- Bootstrap Icons (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <!-- App CSS (local) -->
    <link rel="stylesheet" href="app.css" />

    <!-- Syncfusion Theme -->
    <link rel="stylesheet" href="_content/Syncfusion.Blazor.Themes/bootstrap5.css" />

    <link rel="icon" type="image/png" href="favicon.png" />

    <!-- Hide Blazor error overlay -->
    <style>
        #blazor-error-ui {
            display: none !important;
        }
    </style>
</head>
<body class="bg-light text-dark">

    <app>
        <component type="typeof(DeliveryLogisticsAndTracking.Components.App)" render-mode="ServerPrerendered" />
    </app>

    <!-- Blazor Server runtime -->
    <script src="_framework/blazor.server.js"></script>

    <!-- Bootstrap JS (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

    <!-- Syncfusion JS -->
    <script src="_content/Syncfusion.Blazor.Core/scripts/syncfusion-blazor.min.js"></script>

</body>
</html>